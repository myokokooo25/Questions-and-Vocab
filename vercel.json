{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/admin/access-codes/(.*)",
      "destination": "/api/admin/access-codes?actionPath=$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
